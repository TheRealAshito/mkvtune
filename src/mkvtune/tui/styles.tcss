/* mkvtune v0.4 — MC-shaped chrome + duf-style density, theme-driven.
   Colors come from Textual theme variables, so every theme (dark / amoled /
   bw / bw-light / htop / mc / paper) restyles the whole app consistently. */

Screen {
    background: $background;
    color: $foreground;
}

/* ---- top chrome: menu bar + info bar ---- */

#menubar {
    height: 1;
    background: $panel;
}

.menu-item {
    width: auto;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

.menu-item:hover {
    background: $primary;
    color: $background;
}

#brand {
    width: 1fr;
    padding: 0 1;
    text-align: right;
    color: $text-muted;
}

#infobar {
    height: 1;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

/* ---- body: browser + episodes + tracks ---- */

#body {
    height: 1fr;
}

#browser {
    width: 30%;
    min-width: 28;
    background: $surface;
    border-right: solid $panel-lighten-2;
}

#browser-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-accent;
    text-style: bold;
}

ListItem.panel-up {
    color: $text-accent;
    text-style: bold;
}

ListItem.panel-dir {
    color: $text-primary;
    text-style: bold;
}

ListItem.panel-file {
    color: $foreground;
}

#main {
    width: 1fr;
}

#files {
    height: 2fr;
    background: $surface;
}

#tracks-wrap {
    height: 1fr;
    min-height: 6;
    background: $background;
    border-top: solid $panel-lighten-2;
}

#tracks-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-accent;
    text-style: bold;
}

#tracks {
    height: 1fr;
    background: $background;
}

DataTable > .datatable--header {
    background: $panel;
    color: $text-accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
}

DataTable > .datatable--hover {
    background: $panel-lighten-1;
}

/* ---- bottom chrome: F-key bar + status ---- */

#keybar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

#status.-ok { color: $text-success; }
#status.-error { color: $text-error; }
#status.-busy { color: $text-warning; }

/* ---- dropdown menus ---- */

.menu-dropdown {
    width: 42;
    height: auto;
    max-height: 24;
    background: $surface;
    border: heavy $primary;
    padding: 0 1;
}

/* ---- modal dialogs ---- */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

.modal-box {
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: heavy $primary;
    padding: 1 2;
}

.scan-box {
    width: 62;
}

.modal-title {
    text-style: bold;
    color: $text-accent;
    padding: 0 0 1 0;
}

.modal-text {
    color: $foreground;
}

.modal-actions {
    padding: 1 0 0 0;
    height: auto;
}

Button {
    margin: 0 1 0 0;
}

Button.-primary {
    background: $primary;
    color: auto 87%;
}

.field-label {
    color: $text-accent;
    padding: 1 0 0 0;
}

#settings-box Input,
#settings-box Select,
#settings-box Checkbox {
    margin: 0 0 0 0;
}

#theme-options {
    height: auto;
    max-height: 14;
    background: $background;
    border: solid $panel-lighten-2;
}

.dim { color: $text-muted; }
